<Window x:Class="AxiWidgets.SshSettingsWindow" x:ClassModifier="internal" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="SSH servers" Width="760" Height="470" WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterScreen" Background="#202633" Foreground="#EEF1F8">
 <Window.Resources>
  <Style TargetType="ScrollBar"><Setter Property="Width" Value="6"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Grid Background="#303849"><Track x:Name="PART_Track" IsDirectionReversed="True"><Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="#707D97" CornerRadius="3"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb></Track></Grid></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="Button"><Setter Property="Foreground" Value="#EEF1F8"/><Setter Property="Background" Value="#303848"/><Setter Property="BorderBrush" Value="#485368"/><Setter Property="Padding" Value="12,8"/><Setter Property="Margin" Value="4"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="7"><ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="TextBox"><Setter Property="Background" Value="#2C3240"/><Setter Property="Foreground" Value="#EEF1F8"/><Setter Property="CaretBrush" Value="#38EE65"/><Setter Property="BorderBrush" Value="#485368"/><Setter Property="Padding" Value="0"/><Setter Property="FontSize" Value="14"/><Setter Property="Margin" Value="0,5"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border x:Name="Frame" CornerRadius="7" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"><ScrollViewer x:Name="PART_ContentHost" Margin="10,0" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="#38EE65"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ListBoxItem">
   <Setter Property="Margin" Value="0,3,4,3"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
    <Grid Height="46"><Border x:Name="Row" CornerRadius="8" Background="Transparent" BorderThickness="1" BorderBrush="Transparent"/>
     <Border x:Name="Accent" Width="4" CornerRadius="2" HorizontalAlignment="Left" Background="#38EE65" Visibility="Collapsed"/>
     <Grid Margin="19,0,14,0"><Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <Ellipse x:Name="Dot" Width="15" Height="15" Fill="#8492AC" HorizontalAlignment="Left" VerticalAlignment="Center"/>
      <TextBlock x:Name="ServerTitle" Grid.Column="1" Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" Foreground="#EEF1F8" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
     </Grid>
    </Grid>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="#1838EE65"/></Trigger>
     <Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="#2838EE65"/><Setter TargetName="Row" Property="BorderBrush" Value="#2038EE65"/><Setter TargetName="Accent" Property="Visibility" Value="Visible"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
 </Window.Resources>
 <Grid><Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition/></Grid.RowDefinitions>
  <Border BorderBrush="#485368" BorderThickness="0,0,0,1"><DockPanel Margin="18,0"><Button DockPanel.Dock="Right" Content="✕" Click="Cancel" Background="Transparent" BorderBrush="Transparent"/><TextBlock VerticalAlignment="Center" FontSize="21" FontWeight="SemiBold"><Run Text="&gt;  " Foreground="#38EE65"/><Run Text="SSH servers"/></TextBlock></DockPanel></Border>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="238"/><ColumnDefinition/></Grid.ColumnDefinitions>
   <Border BorderBrush="#485368" BorderThickness="0,0,1,0" Padding="10"><DockPanel><StackPanel DockPanel.Dock="Bottom"><UniformGrid Columns="2"><Button Content="＋ Add" Click="Add"/><Button Content="Remove" Foreground="#FF5965" Click="Remove"/></UniformGrid><Button Content="Import ~/.ssh/config" Click="Import"/></StackPanel><ListBox x:Name="Servers" Background="Transparent" BorderThickness="0" FontSize="15" SelectionChanged="Selected" ScrollViewer.HorizontalScrollBarVisibility="Disabled" PreviewMouseLeftButtonDown="ListDown" PreviewMouseMove="ListMove" PreviewMouseLeftButtonUp="ListUp" LostMouseCapture="ListLostCapture"/></DockPanel></Border>
   <Grid Grid.Column="1" Margin="20,10"><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid x:Name="Fields" TextBlock.FontSize="14"><Grid.ColumnDefinitions><ColumnDefinition Width="67"/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
     <TextBlock Text="Name" VerticalAlignment="Center"/><TextBox x:Name="ServerName" Grid.Column="1"/>
     <TextBlock Grid.Row="1" Text="Host" VerticalAlignment="Center"/><TextBox x:Name="Host" Grid.Row="1" Grid.Column="1"/>
     <TextBlock Grid.Row="2" Text="Port" VerticalAlignment="Center"/><TextBox x:Name="Port" Grid.Row="2" Grid.Column="1"/>
     <TextBlock Grid.Row="3" Text="User" VerticalAlignment="Center"/><TextBox x:Name="User" Grid.Row="3" Grid.Column="1"/>
     <TextBlock Grid.Row="4" Text="Key" VerticalAlignment="Center"/><DockPanel Grid.Row="4" Grid.Column="1"><Button DockPanel.Dock="Right" Content="…" Click="Browse"/><TextBox x:Name="Key"/></DockPanel>
     <TextBlock Grid.Row="5" Text="Options" VerticalAlignment="Center"/><TextBox x:Name="Options" Grid.Row="5" Grid.Column="1" ToolTip="SSH arguments, e.g. -L 8080:localhost:80"/>
    </Grid>
    <TextBlock x:Name="Status" Grid.Row="1" Text="Passwords are not saved." Foreground="#AAB9D2" TextWrapping="Wrap" Margin="67,10,0,6"/>
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Cancel" Click="Cancel"/><Button Content="Save" Click="Save" Background="#38EE65" Foreground="#102618" Width="90"/></StackPanel>
   </Grid>
  </Grid>
 </Grid>
</Window>
