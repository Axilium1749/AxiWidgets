<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <Version>0.1.0</Version>
    <ApplicationIcon>Assets/AxiWidgets.ico</ApplicationIcon>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets/AxiWidgets.ico" />
    <ProjectReference Include="../AxiWidgets.Core/AxiWidgets.Core.csproj" />
    <None Include="../AxiWidgets.Native/bin/AxiWidgets.Native.dll" Link="AxiWidgets.Native.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="BuildNativeCard" BeforeTargets="PrepareForBuild"
          Inputs="../AxiWidgets.Native/SystemMetrics.cpp;../AxiWidgets.Native/CardRenderer.cpp;../AxiWidgets.Native/Build.ps1;../../scripts/toolchain.lock.json"
          Outputs="../AxiWidgets.Native/bin/AxiWidgets.Native.dll">
    <Exec Command="powershell -NoProfile -File &quot;$(MSBuildProjectDirectory)/../AxiWidgets.Native/Build.ps1&quot;" />
  </Target>
</Project>
